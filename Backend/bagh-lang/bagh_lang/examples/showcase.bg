লিখো("🐯 Bagh Lang Showcase শুরু!")

# টাইপ রূপান্তর
সংখ্যা_মান = সংখ্যা("৫")
দশমিক = দশমি("৩.১৪")
বাক্য_টেক্সট = বাক্য(দশমিক)
শব্দ_টেক্সট = শব্দ(সংখ্যা_মান)

লিখো("int:", সংখ্যা_মান)
লিখো("float:", দশমিক)
লিখো("বাক্য:", বাক্য_টেক্সট)
লিখো("শব্দ:", শব্দ_টেক্সট)

# ডাটা স্ট্রাকচার
ফল = তালিকা(["আম", "কলা", "লিচু"])
ছাত্র = তথ্য({
    "নাম": "রফিক",
    "বয়স": সংখ্যা("১৫"),
})

লিখো("দ্বিতীয় ফল:", ফল[১])
লিখো("ছাত্র:", ছাত্র["নাম"], "-", ছাত্র["বয়স"])

# ফাংশন ও কন্ট্রোল ফ্লো
ফাংশন যোগ(ক, খ):
    ফেরত ক + খ

ফাংশন ফিজবাজ(সীমা):
    ঘুরো সূচক সীমা বার:
        সংখ্যা = সূচক + ১
        যদি সংখ্যা % ১৫ == ০:
            লিখো("FizzBuzz")
        নাহলে সংখ্যা % ৩ == ০:
            লিখো("Fizz")
        নাহলে সংখ্যা % ৫ == ০:
            লিখো("Buzz")
        নয়তো:
            লিখো(str(সংখ্যা))

লিখো("যোগের ফল:", যোগ(২, ৩))
লিখো("FizzBuzz ১..১০:")
ফিজবাজ(১০)

# while লুপ ও break/continue
গণনা = ০
লিখো("While লুপ:")
যখন গণনা < ৫:
    গণনা = গণনা + ১
    যদি গণনা == ৪:
        লিখো("থামছি ৪ এ")
        থামাও
    যদি গণনা % ২ == ০:
        চালাও
    লিখো("বিজোড় সংখ্যা:", গণনা)

# স্ট্যান্ডার্ড মডিউল ব্যবহার
লিখো("গণিত sqrt(১৬):", গণিত.sqrt(১৬))
বর্তমান = দশমি(সময়.সময়())
লিখো("সময়.সময়() ->", বর্তমান)
